{
  "name": "brawl-draft-pro",
  "version": "0.1.0",
  "description": "Brawl Draft Pro - Asistente de draft competitivo para Brawl Stars (MVP con datos de ejemplo)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "server": "node server/index.js",
    "dev:all": "npm run server & npm run dev",
    "test": "vitest run",
    "meta:update": "vite-node scripts/update-meta.ts",
    "counters:update": "vite-node scripts/update-counters.ts",
    "data:update": "npm run meta:update && npm run counters:update"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
